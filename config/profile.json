{
  "name": "eo-qa-metrics",
  "tracker": {
    "kind": "azure-devops",
    "project": "Project_Name",
    "organization": "org_name",
    "baseUrl": "https://org_name.visualstudio.com",
    "fieldOverrides": {
      "rootCause": "Custom.RootCause2",
      "severity": "Microsoft.VSTS.Common.Severity",
      "versionDetected": "Microsoft.VSTS.Build.FoundIn",
      "versionCorrected": "Custom.Version"
    }
  },
  "scope": {
    "iterationPathPattern": "\\\\Iteration \\d+"
  },
  "vcs": {
    "kind": "local-git",
    "path": "/Users/akorol/Downloads/Project_Name",
    "branch": "master"
  },
  "period": {
    "from": "2025-09-01T00:00:00.000Z",
    "to": "2026-09-01T00:00:00.000Z"
  },
  "windowDays": 90,
  "versions": {
    "tDet": "v2",
    "env": "v2",
    "imp": "v2",
    "module": "v2",
    "completeness": "v1",
    "cohort": "v3"
  },
  "env": {
    "prodFieldValues": [],
    "prodTags": ["Prod"],
    "prodTitlePrefixes": ["Prod", "PROD"],
    "titlePrefixTokens": 2,
    "deliveryTags": ["Hotfix"],
    "prodCreators": [],
    "prodKeywords": [],
    "closedWorld": true
  },
  "importance": {
    "criticalValues": ["1"], 
    "highValues": ["2"],
    "mediumValues": ["3"], 
    "lowValues": ["4"], 
    "defaultValue": "2",
    "severity": {
      "criticalValues": ["1 - Critical"], 
      "highValues": ["2 - High"],
      "mediumValues": ["3 - Medium"], 
      "lowValues": ["4 - Low"],
      "defaultValue": "3 - Medium"
    }
  },
  "resolution": {
    "rejected": [
      "Not a defect",
      "By design",
      "As Designed"
    ],
    "duplicate": [
      "Duplicate",
      "Copied to Backlog"
    ],
    "noRepro": [
      "Cannot Reproduce",
      "Obsolete"
    ],
    "fixed": [
      "Fixed",
      "Done"
    ]
  },
  "fields": [
    {
      "field": "title",
      "defaultValue": null,
      "mandatory": true
    },
    {
      "field": "reproSteps",
      "defaultValue": null,
      "mandatory": true
    },
    {
      "field": "severity",
      "defaultValue": null,
      "mandatory": true
    },
    {
      "field": "priority",
      "defaultValue": "2",
      "mandatory": true
    },
    {
      "field": "component",
      "defaultValue": null,
      "mandatory": true
    },
    {
      "field": "environmentField",
      "defaultValue": null,
      "mandatory": true
    },
    {
      "field": "versionDetected",
      "defaultValue": null,
      "mandatory": true
    },
    {
      "field": "rootCause",
      "defaultValue": null,
      "mandatory": false
    },
    {
      "field": "resolution",
      "defaultValue": null,
      "mandatory": false
    },
    {
      "field": "assignedTo",
      "defaultValue": null,
      "mandatory": false
    }
  ],
  "thresholds": {
    "completenessMin": 0.95,
    "badReportShareMax": 0.2,
    "reopenRateMax": 0.15,
    "defectiveFixMax": 0.15,
    "flakyRateMax": 0.05,
    "tasFailureShareMax": 0.05,
    "dominanceMax": 0.85,
    "causeFillMin": 0.7,
    "regressionCyclesMax": 4,
    "minCohortSize": 15,
    "ddpTarget": null
  },
  "fixTargetDays": {
    "critical": 3,
    "high": 10,
    "medium": 30,
    "low": 90
  },
  "releases": [
    { "version": "1.42.0", "releasedAt": "2025-10-17" },
    { "version": "1.43.0", "releasedAt": "2025-11-27" },
    { "version": "1.44.0", "releasedAt": "2026-03-17" },
    { "version": "1.45.0", "releasedAt": "2026-04-16" },
    { "version": "1.46.0", "releasedAt": "2026-07-14" }
  ],
  "sprints": [
    {
      "name": "Sprint 101",
      "startsAt": "2026-01-05T00:00:00.000Z",
      "endsAt": "2026-01-18T00:00:00.000Z",
      "releaseVersion": "1.45.0"
    }
  ],
  "manualInputs": {
    "riskRegisterPath": "config/risk-register.json",
    "gateDecisionPath": "config/gate-decision.json",
    "costOfQualityPath": "config/cost-model.json",
    "slaAvailability": 0.995
  },
  "ci": {
    "kind": "azure-pipelines",
    "runSummaryDir": "qa-runs"
  }
}